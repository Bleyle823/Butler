# Pedestal to the robot's right, off the driving lane. The right arm can lower
# onto it from the side without swinging across the chest.
Solid {
  translation 7.55 -4.05 0
  name "pizza pedestal"
  children [
    Pose {
      translation 0 0 0.32
      children [
        Shape {
          appearance USE CABINET
          geometry Cylinder {
            height 0.64
            radius 0.025
          }
          castShadows FALSE
        }
      ]
    }
    Pose {
      translation 0 0 0.655
      children [
        Shape {
          appearance USE CABINET
          geometry Cylinder {
            height 0.02
            radius 0.13
          }
          castShadows FALSE
        }
      ]
    }
  ]
  boundingObject Group {
    children [
      Pose {
        translation 0 0 0.32
        children [
          Cylinder {
            height 0.64
            radius 0.025
          }
        ]
      }
      Pose {
        translation 0 0 0.655
        children [
          Cylinder {
            height 0.02
            radius 0.13
          }
        ]
      }
    ]
  }
}
