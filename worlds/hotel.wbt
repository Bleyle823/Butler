WorldInfo {
  info [
    "Butler hotel. servebot-1 is a full TIAGo++ ServeBot: Astra, Hokuyo, IMU, sonars, Hey5 arms. It runs the pizza job on its own. Select it and press J to rerun, T for teleop. Supervisor 1-5 toggles doors."
  ]
  title "Butler Hotel"
  basicTimeStep 32
  FPS 30
  defaultDamping Damping {
    linear 0.5
    angular 0.5
  }
  contactProperties [
    ContactProperties {
      material1 "default"
      material2 "default"
      coulombFriction 1
      bounce 0
      bounceVelocity 0.01
      softCFM 0.0001
      bumpSound ""
      rollSound ""
      slideSound ""
    }
    ContactProperties {
      material1 "default"
      material2 "floor"
      coulombFriction 1
      bounce 0
      bounceVelocity 0.01
      softCFM 0.0002
      bumpSound ""
      rollSound ""
      slideSound ""
    }
  ]
}
Viewpoint {
  orientation -0.3 0.2 0.93 1.4
  position 6 -14 8
}
Background {
  skyColor [
    0.62 0.72 0.82
  ]
}
DirectionalLight {
  ambientIntensity 1
  direction 0.4 -0.5 -1
  intensity 1.6
  castShadows FALSE
}
Floor {
  size 22 16
  name "hotel floor"
  contactMaterial "floor"
}
Solid {
  translation 0 0 2.4
  rotation 1 0 0 3.14159
  children [
    Shape {
      appearance Roughcast {
        textureTransform TextureTransform {
          scale 10 10
        }
      }
      geometry Plane {
        size 22 16
      }
      castShadows FALSE
    }
  ]
  name "hotel ceiling"
}

# Walls are Solids + Boxes, same trick as jetbot_collision_avoidance.wbt.
