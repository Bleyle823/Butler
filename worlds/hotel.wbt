WorldInfo {
  info [
    "Butler hotel. servebot-1 grasps the kitchen water bottle and delivers it to room 1204. Select the robot and press J to rerun, T for teleop. Supervisor 1-5 toggles doors."
  ]
  title "Butler Hotel"
  basicTimeStep 16
  FPS 30
  defaultDamping Damping {
    linear 0.5
    angular 0.5
  }
  contactProperties [
    ContactProperties {
      bounce 0
      softCFM 0.0001
      bumpSound ""
      rollSound ""
      slideSound ""
    }
    ContactProperties {
      material2 "floor"
      bounce 0
      softCFM 0.0002
      bumpSound ""
      rollSound ""
      slideSound ""
    }
  ]
}
