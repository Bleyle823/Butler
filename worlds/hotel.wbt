#VRML_SIM R2025a utf8
# Butler hotel + restaurant. Indoor floor the ServeBots can walk.
# Box/Plane architecture, shared appearances, no shadow casters.

EXTERNPROTO "../assets/webots/projects/objects/floors/protos/Floor.proto"
EXTERNPROTO "../assets/webots/projects/appearances/protos/Roughcast.proto"
EXTERNPROTO "../assets/webots/projects/appearances/protos/VarnishedPine.proto"
EXTERNPROTO "../assets/webots/projects/objects/tables/protos/Desk.proto"
